{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Finanti API — Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npm", "run", "start:dev"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Finanti API — Debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npm", "run", "start:debug"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "port": 9229
    }
  ]
}
